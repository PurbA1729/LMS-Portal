# Frontend Client Configuration
VITE_API_URL=http://localhost:4000
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Backend Server Configuration (Copy to server/.env or root .env)
PORT=4000
JWT_SECRET=super_secure_jwt_secret_key_change_in_production

# ==============================================================================
# DATABASE CONNECTION (Optional: In-memory mock engine is enabled by default)
# ==============================================================================
# MongoDB Atlas Connection:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/lms_portal?retryWrites=true&w=majority

# PostgreSQL Connection (Alternative):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/lms_portal?schema=public

# ==============================================================================
# GOOGLE CLOUD OAUTH & LOGIN
# ==============================================================================
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==============================================================================
# FILE STORAGE & CLOUD ASSETS (Optional)
# ==============================================================================
# S3_BUCKET=lms-course-materials
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
